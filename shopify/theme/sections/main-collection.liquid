{%- comment -%}
  Collection page: banner, sub-category tabs (tag links), tag facets (material-/stone-/collection-),
  native storefront filters (Search & Discovery app) when configured, sorting and paging.
{%- endcomment -%}
{%- liquid
  assign facet_groups = 'material-|stone-|collection-' | split: '|'
  assign facet_labels = section.settings.material_label | append: '|' | append: section.settings.stone_label | append: '|' | append: section.settings.collection_label | split: '|'
  assign hero_image = section.settings.image | default: collection.image
-%}
<section class="page-hero{% if section.settings.dark %} dark{% endif %}">
  {% render 'image', image: hero_image, fallback: section.settings.fallback_image, alt: collection.title, loading: 'eager' %}
  <div class="page-hero-text">
    <nav class="crumbs light" aria-label="{{ 'general.breadcrumb' | t }}"><a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a> / <span>{{ collection.title }}</span></nav>
    <p class="eyebrow">{{ section.settings.eyebrow }}</p>
    <h1>{{ collection.title }}</h1>
    {%- if collection.description != blank -%}<div class="rte">{{ collection.description }}</div>{%- endif -%}
    {%- if section.settings.button_label != blank -%}<a class="btn btn-light" href="{{ section.settings.button_url }}">{{ section.settings.button_label }}</a>{%- endif -%}
  </div>
</section>

{%- if section.blocks.size > 0 and section.settings.show_tiles -%}
  <section class="section tight">
    <div class="sub-tiles">
      {%- for block in section.blocks -%}
        <a class="sub-tile" href="{{ collection.url }}/{{ block.settings.tag | handle }}#shop" {{ block.shopify_attributes }}>
          <div class="cat-img">{% render 'image', image: block.settings.image, fallback: block.settings.fallback_image, alt: block.settings.label, widths: 600 %}</div>
          <span>{{ block.settings.label }}</span>
        </a>
      {%- endfor -%}
    </div>
  </section>
{%- endif -%}

<section class="section" id="shop">
  <div class="section-head"><p class="eyebrow dark">{{ 'collections.shop' | t }}</p><h2>{{ section.settings.heading | default: collection.title }}</h2></div>
  {%- paginate collection.products by section.settings.per_page -%}
    {%- if section.blocks.size > 0 -%}
      <div class="filters" role="tablist">
        <a class="filter{% if current_tags == blank %} active{% endif %}" href="{{ collection.url }}#shop">{{ 'collections.all' | t }}</a>
        {%- for block in section.blocks -%}
          <a class="filter{% if current_tags contains block.settings.tag %} active{% endif %}" href="{{ collection.url }}/{{ block.settings.tag | handle }}#shop">{{ block.settings.label }}</a>
        {%- endfor -%}
      </div>
    {%- endif -%}

    <div class="shop-bar">
      <button class="btn-outline filter-toggle" id="filterOpen">{% render 'icon', name: 'filter' %} {{ 'collections.filter_sort' | t }}</button>
      <p class="result-count">{{ 'collections.count' | t: count: paginate.items }}</p>
      <label class="sort-wrap">{{ 'collections.sort_by' | t }}
        <select id="sortSelect">
          {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
          {%- for option in collection.sort_options -%}<option value="{{ option.value }}"{% if option.value == sort_by %} selected{% endif %}>{{ option.name }}</option>{%- endfor -%}
        </select>
      </label>
    </div>

    <div class="active-chips">
      {%- for tag in current_tags -%}
        {%- assign label = tag | remove_first: 'material-' | remove_first: 'stone-' | remove_first: 'collection-' | replace: '-', ' ' | capitalize -%}
        <span class="chip">{{ label | append: ' ×' | link_to_remove_tag: tag }}</span>
      {%- endfor -%}
      {%- for filter in collection.filters -%}
        {%- for value in filter.active_values -%}<a class="chip" href="{{ value.url_to_remove }}">{{ value.label }} ×</a>{%- endfor -%}
        {%- if filter.type == 'price_range' -%}
          {%- if filter.min_value.value != nil or filter.max_value.value != nil -%}<a class="chip" href="{{ filter.url_to_remove }}">{{ filter.label }} ×</a>{%- endif -%}
        {%- endif -%}
      {%- endfor -%}
      {%- if current_tags or collection.filters.size > 0 -%}
        {%- assign any_filter = false -%}
        {%- for filter in collection.filters -%}{%- if filter.active_values.size > 0 -%}{%- assign any_filter = true -%}{%- endif -%}{%- endfor -%}
        {%- if current_tags or any_filter -%}<a class="link-btn" href="{{ collection.url }}#shop">{{ 'collections.clear' | t }}</a>{%- endif -%}
      {%- endif -%}
    </div>

    <div class="shop-layout">
      <aside class="filter-panel" id="filterPanel" aria-label="{{ 'collections.filters' | t }}">
        <div class="filter-panel-head"><h3>{{ 'collections.filter' | t }}</h3><button class="icon-btn" aria-label="{{ 'general.close' | t }}" id="filterClose">{% render 'icon', name: 'close' %}</button></div>

        {%- for prefix in facet_groups -%}
          {%- capture links -%}
            {%- for tag in collection.all_tags -%}
              {%- assign start = tag | slice: 0, prefix.size -%}
              {%- if start == prefix -%}
                {%- assign label = tag | remove_first: prefix | replace: '-', ' ' | capitalize -%}
                {%- if current_tags contains tag -%}
                  <span class="facet on">{{ label | link_to_remove_tag: tag }}</span>
                {%- else -%}
                  <span class="facet">{{ label | link_to_add_tag: tag }}</span>
                {%- endif -%}
              {%- endif -%}
            {%- endfor -%}
          {%- endcapture -%}
          {%- if links != blank -%}
            <details class="filter-group" open><summary><h4>{{ facet_labels[forloop.index0] }}</h4></summary><div class="facet-links">{{ links }}</div></details>
          {%- endif -%}
        {%- endfor -%}

        {%- if collection.filters.size > 0 -%}
          <form data-filter-form action="{{ collection.url }}">
            {%- for filter in collection.filters -%}
              <details class="filter-group" open><summary><h4>{{ filter.label }}</h4></summary>
                {%- case filter.type -%}
                  {%- when 'price_range' -%}
                    <div class="price-inputs">
                      <input type="number" name="{{ filter.min_value.param_name }}" placeholder="0" value="{{ filter.min_value.value | money_without_currency | remove: ',' }}" aria-label="{{ 'collections.min' | t }}">
                      <span>–</span>
                      <input type="number" name="{{ filter.max_value.param_name }}" placeholder="{{ filter.range_max | money_without_currency | remove: ',' }}" value="{{ filter.max_value.value | money_without_currency | remove: ',' }}" aria-label="{{ 'collections.max' | t }}">
                    </div>
                  {%- else -%}
                    {%- for value in filter.values -%}
                      <label class="check-line"><input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}"{% if value.active %} checked{% endif %}{% if value.count == 0 and value.active == false %} disabled{% endif %}> {{ value.label }} <span class="count">({{ value.count }})</span></label>
                    {%- endfor -%}
                {%- endcase -%}
              </details>
            {%- endfor -%}
            {%- if collection.sort_by -%}<input type="hidden" name="sort_by" value="{{ collection.sort_by }}">{%- endif -%}
            <noscript><button class="btn btn-dark" type="submit">{{ 'collections.apply' | t }}</button></noscript>
          </form>
        {%- endif -%}
        <div class="filter-panel-foot"><a class="btn-outline" href="{{ collection.url }}">{{ 'collections.clear' | t }}</a><button class="btn btn-dark" id="applyFilters">{{ 'collections.show' | t }}</button></div>
      </aside>

      <div>
        {%- if collection.products.size > 0 -%}
          <div class="product-grid">
            {%- for product in collection.products -%}{% render 'product-card', product: product %}{%- endfor -%}
          </div>
        {%- else -%}
          <div class="empty-state"><p>{{ 'collections.empty' | t }}</p><a class="btn btn-dark" href="{{ collection.url }}">{{ 'collections.clear' | t }}</a></div>
        {%- endif -%}
        {%- if paginate.pages > 1 -%}
          <ul class="pagination">
            {%- for part in paginate.parts -%}
              <li>{%- if part.is_link -%}<a href="{{ part.url }}">{{ part.title }}</a>{%- elsif part.title == paginate.current_page -%}<span class="current">{{ part.title }}</span>{%- else -%}<span>{{ part.title }}</span>{%- endif -%}</li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
    </div>
  {%- endpaginate -%}
</section>

{% schema %}
{
  "name": "Collection page",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Banner image", "info": "Defaults to the collection image." },
    { "type": "text", "id": "fallback_image", "label": "Default image file", "default": "necklace-model.jpg" },
    { "type": "checkbox", "id": "dark", "label": "Darker overlay", "default": false },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Fine Jewellery" },
    { "type": "text", "id": "button_label", "label": "Banner button label" },
    { "type": "url", "id": "button_url", "label": "Banner button link" },
    { "type": "text", "id": "heading", "label": "Products heading" },
    { "type": "checkbox", "id": "show_tiles", "label": "Show sub-category tiles", "default": true },
    { "type": "range", "id": "per_page", "label": "Products per page", "min": 12, "max": 48, "step": 12, "default": 24 },
    { "type": "header", "content": "Filter labels" },
    { "type": "text", "id": "material_label", "label": "Material group", "default": "Metal & Material" },
    { "type": "text", "id": "stone_label", "label": "Gemstone group", "default": "Gemstone" },
    { "type": "text", "id": "collection_label", "label": "Collection group", "default": "Collection" }
  ],
  "blocks": [
    { "type": "sub", "name": "Sub-category", "settings": [
      { "type": "text", "id": "label", "label": "Label", "default": "Rings" },
      { "type": "text", "id": "tag", "label": "Product tag", "default": "rings" },
      { "type": "image_picker", "id": "image", "label": "Tile image" },
      { "type": "text", "id": "fallback_image", "label": "Default image file" }
    ] }
  ]
}
{% endschema %}
