<div class="related-wrap page-width" data-recommendations="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.limit }}">
  {%- if recommendations.performed and recommendations.products_count > 0 -%}
    <h3>{{ section.settings.heading }}</h3>
    <div class="product-grid four">
      {%- for product in recommendations.products -%}{% render 'product-card', product: product %}{%- endfor -%}
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Related products",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "You may also like" },
    { "type": "range", "id": "limit", "label": "Products", "min": 2, "max": 8, "step": 1, "default": 4 }
  ]
}
{% endschema %}
