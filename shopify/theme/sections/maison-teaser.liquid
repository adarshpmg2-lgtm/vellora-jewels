<section class="maison" id="{{ section.settings.anchor | default: section.id }}">
  <div class="maison-img">{% render 'image', image: section.settings.image, fallback: section.settings.fallback_image, alt: section.settings.heading, widths: 1400 %}</div>
  <div class="maison-text" data-reveal>
    <p class="eyebrow dark">{{ section.settings.eyebrow }}</p>
    <h2>{{ section.settings.heading }}</h2>
    <p>{{ section.settings.text }}</p>
    <div class="stats">
      {%- for block in section.blocks -%}
        <div {{ block.shopify_attributes }}><strong data-count="{{ block.settings.number }}" data-suffix="{{ block.settings.suffix }}">{{ block.settings.number }}{{ block.settings.suffix }}</strong><span>{{ block.settings.label }}</span></div>
      {%- endfor -%}
    </div>
    {%- if section.settings.button_label != blank -%}<a href="{{ section.settings.button_url }}" class="btn btn-dark">{{ section.settings.button_label }}</a>{%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Maison with figures",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "fallback_image", "label": "Default image file", "default": "colosseum.jpg" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Maison" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "A Century of Roman Splendour" },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Our History" },
    { "type": "url", "id": "button_url", "label": "Button link" },
    { "type": "text", "id": "anchor", "label": "Anchor id" }
  ],
  "blocks": [
    { "type": "figure", "name": "Figure", "limit": 4, "settings": [
      { "type": "number", "id": "number", "label": "Number", "default": 100 },
      { "type": "text", "id": "suffix", "label": "Suffix", "default": "+" },
      { "type": "text", "id": "label", "label": "Label", "default": "Years of craft" }
    ] }
  ],
  "presets": [{ "name": "Maison with figures", "blocks": [{ "type": "figure" }] }]
}
{% endschema %}
