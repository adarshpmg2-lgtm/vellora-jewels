<section class="section{% if section.settings.cream %} cream{% endif %}" id="{{ section.settings.anchor | default: section.id }}">
  <div class="section-head" data-reveal><p class="eyebrow dark">{{ section.settings.eyebrow }}</p><h2>{{ section.settings.heading }}</h2></div>
  {%- assign figures = section.blocks | where: 'type', 'figure' -%}
  {%- if figures.size > 0 -%}
    <div class="stats big" data-reveal>
      {%- for block in figures -%}<div {{ block.shopify_attributes }}><strong data-count="{{ block.settings.number }}" data-suffix="{{ block.settings.suffix }}">{{ block.settings.number }}{{ block.settings.suffix }}</strong><span>{{ block.settings.label }}</span></div>{%- endfor -%}
    </div>
  {%- endif -%}
  <div class="info-grid">
    {%- for block in section.blocks -%}
      {%- if block.type == 'item' -%}<div {{ block.shopify_attributes }}><h4>{{ block.settings.title }}</h4><div class="rte">{{ block.settings.text }}</div></div>{%- endif -%}
    {%- endfor -%}
  </div>
  {%- if section.settings.note != blank -%}<p class="center muted">{{ section.settings.note }}</p>{%- endif -%}
</section>

{% schema %}
{
  "name": "Information grid",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Client Services" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Jewellery Care" },
    { "type": "text", "id": "note", "label": "Note under the grid" },
    { "type": "checkbox", "id": "cream", "label": "Cream background", "default": false },
    { "type": "text", "id": "anchor", "label": "Anchor id", "info": "Lets menus link here, e.g. care → /collections/jewellery#care" }
  ],
  "blocks": [
    { "type": "item", "name": "Item", "settings": [
      { "type": "text", "id": "title", "label": "Title", "default": "Title" },
      { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Text</p>" }
    ] },
    { "type": "figure", "name": "Figure", "settings": [
      { "type": "number", "id": "number", "label": "Number", "default": 100 },
      { "type": "text", "id": "suffix", "label": "Suffix", "default": "%" },
      { "type": "text", "id": "label", "label": "Label", "default": "Label" }
    ] }
  ],
  "presets": [{ "name": "Information grid", "blocks": [{ "type": "item" }, { "type": "item" }, { "type": "item" }] }]
}
{% endschema %}
