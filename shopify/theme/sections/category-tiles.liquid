<section class="section{% if section.settings.cream %} cream{% endif %}{% if section.settings.tight %} tight{% endif %}" id="{{ section.settings.anchor | default: section.id }}">
  {%- if section.settings.heading != blank -%}
    <div class="section-head" data-reveal><p class="eyebrow dark">{{ section.settings.eyebrow }}</p><h2>{{ section.settings.heading }}</h2></div>
  {%- endif -%}
  <div class="{% if section.settings.layout == 'tiles' %}cat-grid{% else %}sub-tiles{% endif %}" data-reveal>
    {%- for block in section.blocks -%}
      <a href="{{ block.settings.url }}" class="{% if section.settings.layout == 'tiles' %}cat-card{% else %}sub-tile{% endif %}" {{ block.shopify_attributes }}>
        <div class="cat-img">{% render 'image', image: block.settings.image, fallback: block.settings.fallback_image, alt: block.settings.title, widths: 800 %}</div>
        <span>{{ block.settings.title }}</span>
        {%- if block.settings.caption != blank -%}<small>{{ block.settings.caption }}</small>{%- endif -%}
      </a>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Category tiles",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Explore" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The World of VELLORA" },
    { "type": "select", "id": "layout", "label": "Layout", "default": "tiles", "options": [
      { "value": "tiles", "label": "Four large tiles" }, { "value": "small", "label": "Small square tiles" } ] },
    { "type": "checkbox", "id": "cream", "label": "Cream background", "default": false },
    { "type": "checkbox", "id": "tight", "label": "Less spacing", "default": false },
    { "type": "text", "id": "anchor", "label": "Anchor id" }
  ],
  "blocks": [
    { "type": "tile", "name": "Tile", "settings": [
      { "type": "image_picker", "id": "image", "label": "Image" },
      { "type": "text", "id": "fallback_image", "label": "Default image file" },
      { "type": "text", "id": "title", "label": "Title", "default": "Rings" },
      { "type": "text", "id": "caption", "label": "Caption" },
      { "type": "url", "id": "url", "label": "Link" }
    ] }
  ],
  "presets": [{ "name": "Category tiles", "blocks": [{ "type": "tile" }, { "type": "tile" }, { "type": "tile" }, { "type": "tile" }] }]
}
{% endschema %}
