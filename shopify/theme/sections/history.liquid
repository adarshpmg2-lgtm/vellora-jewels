{%- comment -%} "Our History" page: hero, intro figures, sticky decade bar and one block per chapter. {%- endcomment -%}
<section class="hist-hero">
  {% render 'image', image: section.settings.image, fallback: 'colosseum.jpg', alt: section.settings.heading, loading: 'eager' %}
  <div class="hist-hero-text">
    <nav class="crumbs light" aria-label="{{ 'general.breadcrumb' | t }}"><a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a> / <a href="/pages/maison">The Maison</a> / <span>{{ page.title }}</span></nav>
    <p class="eyebrow">{{ section.settings.eyebrow }}</p>
    <h1>{{ section.settings.heading }}</h1>
    <p>{{ section.settings.subheading }}</p>
  </div>
  <a href="#hist-intro" class="scroll-cue" aria-label="{{ 'general.scroll' | t }}"></a>
</section>

<section class="hist-intro" id="hist-intro">
  <p class="hist-lead" data-reveal>{{ section.settings.lead }}</p>
  <div class="hist-figures" data-reveal>
    {%- for i in (1..4) -%}
      {%- assign k = 'fig' | append: i -%}{%- assign kl = k | append: '_label' -%}
      {%- if section.settings[k] != blank -%}<div><strong>{{ section.settings[k] }}</strong><span>{{ section.settings[kl] }}</span></div>{%- endif -%}
    {%- endfor -%}
  </div>
</section>

<nav class="decade-nav" id="decadeNav" aria-label="{{ 'history.decades' | t }}">
  <div class="decade-progress"><span id="histProgress"></span></div>
  <div class="decade-links">
    {%- for block in section.blocks -%}<a href="#y{{ block.settings.year }}">{{ block.settings.decade }}</a>{%- endfor -%}
  </div>
</nav>

<div class="chapters">
  {%- for block in section.blocks -%}
    {%- assign s = block.settings -%}
    {%- if s.full_width -%}
      <section class="chapter full" id="y{{ s.year }}" {{ block.shopify_attributes }}>
        {% render 'image', image: s.image, fallback: s.fallback_image, alt: s.image_alt, vintage: s.vintage, widths: 2000 %}
        <div class="chapter-full-text">
          <span class="ch-year">{{ s.year }}</span>
          <h2>{{ s.title }}</h2>
          <div class="rte">{{ s.text }}</div>
        </div>
      </section>
    {%- else -%}
      <section class="chapter{% cycle '', ' rev' %}" id="y{{ s.year }}" data-reveal {{ block.shopify_attributes }}>
        <figure class="ch-img">
          {% render 'image', image: s.image, fallback: s.fallback_image, alt: s.image_alt, vintage: s.vintage, widths: 1200 %}
          {%- if s.caption != blank -%}<figcaption>{{ s.caption }}</figcaption>{%- endif -%}
        </figure>
        <div class="ch-text">
          <span class="ch-year">{{ s.year }}</span>
          <p class="eyebrow dark">{{ s.decade }}</p>
          <h2>{{ s.title }}</h2>
          <div class="rte">{{ s.text }}</div>
          {%- if s.quote != blank -%}<blockquote>“{{ s.quote }}”{%- if s.quote_by != blank -%}<cite>— {{ s.quote_by }}</cite>{%- endif -%}</blockquote>{%- endif -%}
          {%- assign p = all_products[s.product] -%}
          {%- if s.product != blank and p.id -%}
            <a class="ch-product" href="{{ p.url }}">
              {%- if p.featured_media -%}{{ p.featured_media | image_url: width: 140 | image_tag: loading: 'lazy', alt: '' }}{%- endif -%}
              <span><small>{{ 'history.born_here' | t }}</small>{{ p.title }}<em>{{ 'history.discover_creation' | t }}</em></span>
            </a>
          {%- endif -%}
          {%- if s.link_label != blank -%}<a class="link-arrow" href="{{ s.link_url }}">{{ s.link_label }} →</a>{%- endif -%}
        </div>
      </section>
    {%- endif -%}
  {%- endfor -%}
</div>

<section class="hist-end" data-reveal>
  <p class="eyebrow dark">{{ 'history.continues' | t }}</p>
  <h2>{{ 'history.written' | t }}</h2>
  <p>{{ 'history.end_text' | t }}</p>
  <div class="hist-end-links">
    <a class="duo-card" href="/pages/maison#ateliers"><img src="{{ 'hands-model.jpg' | asset_url }}" alt="" loading="lazy" width="900" height="675"><div><h3>The Ateliers</h3><span>{{ 'general.discover' | t }}</span></div></a>
    <a class="duo-card" href="{{ routes.collections_url }}/high-jewellery"><img src="{{ 'necklace-diamond.jpg' | asset_url }}" alt="" loading="lazy" width="900" height="675"><div><h3>High Jewellery</h3><span>{{ 'general.discover' | t }}</span></div></a>
    <a class="duo-card" href="{{ routes.collections_url }}/jewellery/collection-aurea-eterna"><img src="{{ 'hero.jpg' | asset_url }}" alt="" loading="lazy" width="900" height="675"><div><h3>Aurea Eterna</h3><span>{{ 'general.discover' | t }}</span></div></a>
  </div>
</section>

{% schema %}
{
  "name": "History",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Hero image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "1924 — Today" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Our History" },
    { "type": "text", "id": "subheading", "label": "Subheading" },
    { "type": "textarea", "id": "lead", "label": "Introduction" },
    { "type": "header", "content": "Key figures" },
    { "type": "text", "id": "fig1", "label": "Figure 1" }, { "type": "text", "id": "fig1_label", "label": "Figure 1 label" },
    { "type": "text", "id": "fig2", "label": "Figure 2" }, { "type": "text", "id": "fig2_label", "label": "Figure 2 label" },
    { "type": "text", "id": "fig3", "label": "Figure 3" }, { "type": "text", "id": "fig3_label", "label": "Figure 3 label" },
    { "type": "text", "id": "fig4", "label": "Figure 4" }, { "type": "text", "id": "fig4_label", "label": "Figure 4 label" }
  ],
  "blocks": [
    { "type": "chapter", "name": "Chapter", "settings": [
      { "type": "text", "id": "year", "label": "Year", "default": "1924" },
      { "type": "text", "id": "decade", "label": "Decade label", "default": "1920s" },
      { "type": "text", "id": "title", "label": "Title", "default": "Chapter title" },
      { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Chapter text.</p>" },
      { "type": "image_picker", "id": "image", "label": "Image" },
      { "type": "text", "id": "fallback_image", "label": "Default image file" },
      { "type": "text", "id": "image_alt", "label": "Image description" },
      { "type": "checkbox", "id": "vintage", "label": "Vintage (sepia) tone", "default": false },
      { "type": "checkbox", "id": "full_width", "label": "Full-screen chapter", "default": false },
      { "type": "text", "id": "caption", "label": "Image caption" },
      { "type": "textarea", "id": "quote", "label": "Quote" },
      { "type": "text", "id": "quote_by", "label": "Quote author" },
      { "type": "text", "id": "product", "label": "Product handle born in this era" },
      { "type": "text", "id": "link_label", "label": "Link label" },
      { "type": "url", "id": "link_url", "label": "Link" }
    ] }
  ]
}
{% endschema %}
