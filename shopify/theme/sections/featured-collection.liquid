{%- assign coll = collections[section.settings.collection] -%}
<section class="section{% if section.settings.cream %} cream{% endif %}" id="{{ section.settings.anchor | default: section.id }}">
  <div class="section-head" data-reveal><p class="eyebrow dark">{{ section.settings.eyebrow }}</p><h2>{{ section.settings.heading }}</h2></div>
  <div class="product-grid four">
    {%- if coll.products_count > 0 -%}
      {%- for product in coll.products limit: section.settings.limit -%}{% render 'product-card', product: product %}{%- endfor -%}
    {%- else -%}
      {%- for i in (1..4) -%}<article class="p-card"><div class="p-img">{{ 'product-1' | placeholder_svg_tag }}</div><p class="p-name">{{ 'products.placeholder' | t }}</p></article>{%- endfor -%}
    {%- endif -%}
  </div>
  {%- if section.settings.button_label != blank and coll -%}
    <p class="center"><a class="btn-outline" href="{{ coll.url }}">{{ section.settings.button_label }}</a></p>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Selection" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "New & Iconic" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "label": "Products", "min": 4, "max": 16, "step": 4, "default": 8 },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "View all" },
    { "type": "checkbox", "id": "cream", "label": "Cream background", "default": false },
    { "type": "text", "id": "anchor", "label": "Anchor id" }
  ],
  "presets": [{ "name": "Featured collection" }]
}
{% endschema %}
