<section class="section cream" id="{{ section.settings.anchor | default: 'guide' }}">
  <div class="section-head" data-reveal><p class="eyebrow dark">{{ section.settings.eyebrow }}</p><h2>{{ section.settings.heading }}</h2></div>
  <div data-tabs>
    <div class="tabs" role="tablist">
      {%- for block in section.blocks -%}<button role="tab" type="button" data-tab="{{ block.id }}" class="{% if forloop.first %}active{% endif %}" aria-selected="{{ forloop.first }}" {{ block.shopify_attributes }}>{{ block.settings.title }}</button>{%- endfor -%}
    </div>
    {%- for block in section.blocks -%}<p class="tab-text" data-panel="{{ block.id }}"{% unless forloop.first %} hidden{% endunless %}>{{ block.settings.text }}</p>{%- endfor -%}
  </div>
</section>

<section class="section" id="shapes">
  <div class="section-head" data-reveal><p class="eyebrow dark">{{ 'bridal.shapes_eyebrow' | t }}</p><h2>{{ 'bridal.shapes' | t }}</h2></div>
  <div class="shape-grid">
    {%- assign shapes = 'Round|Oval|Emerald|Cushion|Pear|Princess' | split: '|' -%}
    {%- for s in shapes -%}
      <a class="shape" href="{{ section.settings.shapes_url }}">
        <svg viewBox="0 0 40 40" aria-hidden="true">
          {%- case s -%}
            {%- when 'Round' -%}<circle cx="20" cy="20" r="15"/>
            {%- when 'Oval' -%}<ellipse cx="20" cy="20" rx="11" ry="16"/>
            {%- when 'Emerald' -%}<path d="M13 4h14l7 7v18l-7 7H13l-7-7V11z"/>
            {%- when 'Cushion' -%}<rect x="5" y="5" width="30" height="30" rx="9"/>
            {%- when 'Pear' -%}<path d="M20 3c6 9 13 15 13 23a13 13 0 0 1-26 0c0-8 7-14 13-23z"/>
            {%- else -%}<rect x="6" y="6" width="28" height="28"/>
          {%- endcase -%}
        </svg><span>{{ s }}</span></a>
    {%- endfor -%}
  </div>
</section>

<section class="section cream" id="size-guide">
  <div class="section-head" data-reveal><p class="eyebrow dark">{{ 'bridal.size_eyebrow' | t }}</p><h2>{{ 'bridal.size_guide' | t }}</h2></div>
  <div class="size-wrap">
    <div class="info-grid two">
      <div><h4>{{ 'bridal.measure_ring' | t }}</h4><p>{{ 'bridal.measure_ring_text' | t }}</p></div>
      <div><h4>{{ 'bridal.measure_finger' | t }}</h4><p>{{ 'bridal.measure_finger_text' | t }}</p></div>
    </div>
    <table class="size-table">
      <thead><tr><th>{{ 'bridal.col_size' | t }}</th><th>{{ 'bridal.col_circ' | t }}</th><th>{{ 'bridal.col_diam' | t }}</th><th>{{ 'bridal.col_indian' | t }}</th></tr></thead>
      <tbody>
        {%- assign rows = '48,48,15.3,8|50,50,15.9,10|52,52,16.5,12|54,54,17.2,14|56,56,17.8,16|58,58,18.5,18' | split: '|' -%}
        {%- for r in rows -%}<tr>{%- assign cells = r | split: ',' -%}{%- for c in cells -%}<td>{{ c }}</td>{%- endfor -%}</tr>{%- endfor -%}
      </tbody>
    </table>
    <p class="muted">{{ 'bridal.size_note' | t }}</p>
  </div>
</section>

{% schema %}
{
  "name": "Diamond & size guide",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Diamond Guide" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The 4Cs" },
    { "type": "url", "id": "shapes_url", "label": "Diamond shapes link" },
    { "type": "text", "id": "anchor", "label": "Anchor id", "default": "guide" }
  ],
  "blocks": [
    { "type": "tab", "name": "Tab", "settings": [
      { "type": "text", "id": "title", "label": "Title", "default": "Cut" },
      { "type": "textarea", "id": "text", "label": "Text" }
    ] }
  ],
  "presets": [{ "name": "Diamond & size guide", "blocks": [{ "type": "tab" }] }]
}
{% endschema %}
