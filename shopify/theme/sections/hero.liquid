{%- if section.settings.style == 'page' -%}
  <section class="page-hero{% if section.settings.dark %} dark{% endif %}">
    {% render 'image', image: section.settings.image, fallback: section.settings.fallback_image, alt: section.settings.heading, loading: 'eager' %}
    <div class="page-hero-text">
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      <h1>{{ section.settings.heading }}</h1>
      {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
      {%- if section.settings.button_label != blank -%}<a class="btn btn-light" href="{{ section.settings.button_url }}">{{ section.settings.button_label }}</a>{%- endif -%}
    </div>
  </section>
{%- else -%}
  <section class="hero">
    {% render 'image', image: section.settings.image, fallback: section.settings.fallback_image, alt: section.settings.heading, class: 'hero-img', loading: 'eager' %}
    <div class="hero-content">
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      <h1>{{ section.settings.heading }}</h1>
      {%- if section.settings.text != blank -%}<p class="hero-sub">{{ section.settings.text }}</p>{%- endif -%}
      {%- if section.settings.button_label != blank -%}<a href="{{ section.settings.button_url }}" class="btn btn-light">{{ section.settings.button_label }}</a>{%- endif -%}
    </div>
    <a href="#{{ section.id }}-next" class="scroll-cue" aria-label="{{ 'general.scroll' | t }}"></a>
  </section>
  <span id="{{ section.id }}-next"></span>
{%- endif -%}

{% schema %}
{
  "name": "Hero banner",
  "settings": [
    { "type": "select", "id": "style", "label": "Style", "default": "full", "options": [
      { "value": "full", "label": "Full screen (home)" }, { "value": "page", "label": "Page banner" } ] },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "fallback_image", "label": "Default image file", "default": "hero.jpg", "info": "Theme asset used when no image is picked." },
    { "type": "checkbox", "id": "dark", "label": "Darker overlay", "default": false },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "New Collection" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Aurea Eterna" },
    { "type": "text", "id": "text", "label": "Text", "default": "Roman gold, sculpted by hand into light." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Discover the Collection" },
    { "type": "url", "id": "button_url", "label": "Button link" }
  ],
  "presets": [{ "name": "Hero banner" }]
}
{% endschema %}
