    "ateliers": {
      "type": "image-with-text",
      "settings": {
        "fallback_image": "model-ring.jpg",
        "eyebrow": "Craftsmanship",
        "heading": "From Sketch to Jewel",
        "text": "<p>More than 300 artisans work in our Roman ateliers. A single high jewellery necklace passes through the hands of designers, wax modellers, goldsmiths, setters and polishers.</p>",
        "steps": "Design — gouache drawings at life size\nModelling — carved in wax or metal\nGoldsmithing — cast, assembled and soldered\nSetting — every stone placed by hand\nPolishing — until the gold glows",
        "anchor": "ateliers"
      }
    },
